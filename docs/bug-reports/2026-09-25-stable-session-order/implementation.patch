+  const client = createThreadListClient(async () => ({ items: [{ ...createThread(), updatedAt }], nextCursor: null }));
+  client.readThread = async (_id, options) => {
+    if (options) historyReads += 1;
+    return { ...createThread(), updatedAt };
+  };
