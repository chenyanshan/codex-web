+  assert.equal((await restarted.readSession('thread_1'))?.listOrderAt, 123);
+  rejected = true;
+  await assert.rejects(restarted.startTurn('thread_1', { text: 'rejected' }), /provider rejected/);
+  assert.equal((await restarted.readSession('thread_1'))?.listOrderAt, 123);
+  rejected = false;
+  await restarted.startTurn('thread_1', { text: 'accepted' });
